<Project>
  <!-- Log all shared properties that are set by the Basilisque.CommonBuild project -->
  <Target Name="LogBasilisqueCommonSharedBuildProperties" AfterTargets="PrepareForBuild" Condition="'$(BAS_CB_Log_Properties)' == 'true'">
    <PropertyGroup>
      <__BAS_Log_Msg>
==BAS_CB_Properties - begin shared ($(MSBuildProjectName))==
  BAS_CB_ProjType_CodeAnalysis = '$(BAS_CB_ProjType_CodeAnalysis)'
  BAS_CB_ProjType_Tests = '$(BAS_CB_ProjType_Tests)'
  BAS_CB_ProjType_Benchmarks = '$(BAS_CB_ProjType_Benchmarks)'
  BAS_CB_Set_IsPackable = '$(BAS_CB_Set_IsPackable)'
  BAS_CB_Set_RunSettingsFilePath = '$(BAS_CB_Set_RunSettingsFilePath)'
  BAS_CB_Use_GitVersion = '$(BAS_CB_Use_GitVersion)'
  BAS_CB_BuildType = '$(BAS_CB_BuildType)'
  BAS_CB_Set_SonarQubeTestProject = '$(BAS_CB_Set_SonarQubeTestProject)'
  PackageVersion = '$(PackageVersion)'
  IsPackable = '$(IsPackable)'
  IsPublishable = '$(IsPublishable)'
  IsTestProject = '$(IsTestProject)'
  RunSettingsFilePath = '$(RunSettingsFilePath)'
  SonarQubeTestProject = '$(SonarQubeTestProject)'
==BAS_CB_Properties - end shared ($(MSBuildProjectName))==
      </__BAS_Log_Msg>
    </PropertyGroup>
    <Message Importance="High" Text="$(__BAS_Log_Msg)" />
  </Target>

  <!-- NuGet package properties and project info -->
  <PropertyGroup>
    <IsPackable Condition="'$(BAS_CB_Set_IsPackable)' == 'true' AND $(Configuration)!='Release'">false</IsPackable>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Basilisque.CommonBuild.Versioning.targets" Condition="'$(BasilisqueCommonBuildVersioningTargets_Imported)' != 'true'" />

  <!-- .Tests projects -->
  <PropertyGroup Condition="'$(BAS_CB_ProjType_Tests)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>true</IsTestProject>
    <SonarQubeTestProject Condition="'$(BAS_CB_Set_SonarQubeTestProject)' == 'true'">true</SonarQubeTestProject>

    <RunSettingsFilePath Condition="'$(BAS_CB_Set_RunSettingsFilePath)' == 'true' AND '$(RunSettingsFilePath)' == ''">$(MSBuildThisFileDirectory)CommonBuild.MSTest.runsettings</RunSettingsFilePath>
  </PropertyGroup>

  <!-- .Benchmarks projects -->
  <PropertyGroup Condition="'$(BAS_CB_ProjType_Benchmarks)' == 'true'">
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <SonarQubeTestProject Condition="'$(BAS_CB_Set_SonarQubeTestProject)' == 'true'">true</SonarQubeTestProject>
  </PropertyGroup>

  <!-- versioning -->
  <PropertyGroup>
    <MarkupCompilePass1DependsOn>$(MarkupCompilePass1DependsOn);BAS_CB_SetVersionProperties</MarkupCompilePass1DependsOn>
    <GetPackageVersionDependsOn>$(GetPackageVersionDependsOn);BAS_CB_SetVersionProperties</GetPackageVersionDependsOn>
  </PropertyGroup>
  <PropertyGroup Condition="'$(BAS_CB_ProjType_CodeAnalysis)' == 'true' AND '$(BAS_CB_CodeAnalysis_PackCS)' != 'false'">
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);BAS_CB_GetCodeAnalysisPackageFiles</TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>
  <Target Name="BAS_CB_GetCodeAnalysisPackageFiles"
          DependsOnTargets="BAS_CB_SetAssemblyNameVersionSuffix"
          Condition="'$(BAS_CB_ProjType_CodeAnalysis)' == 'true' AND '$(BAS_CB_CodeAnalysis_PackCS)' != 'false'">
    <!-- NU5128 - https://github.com/dotnet/aspnetcore/issues/744 -->
    <MakeDir Directories="$(IntermediateOutputPath)Basilisque.CommonBuild" Condition="'$(IncludeBuildOutput)' == 'false'" />
    <WriteLinesToFile File="$(IntermediateOutputPath)Basilisque.CommonBuild/_._" Lines="" Overwrite="true" WriteOnlyWhenDifferent="true" Condition="'$(IncludeBuildOutput)' == 'false'" />
    <ItemGroup>
      <TfmSpecificPackageFile Include="$(TargetPath)" PackagePath="analyzers/dotnet/cs" />
      <TfmSpecificPackageFile Include="$(IntermediateOutputPath)Basilisque.CommonBuild/_._" PackagePath="lib/$(TargetFramework)" Condition="'$(IncludeBuildOutput)' == 'false'" />
      <FileWrites Include="$(IntermediateOutputPath)Basilisque.CommonBuild/_._" Condition="'$(IncludeBuildOutput)' == 'false'" />
    </ItemGroup>
  </Target>
  <PropertyGroup Condition="'$(DisableGitVersionTask)' == 'false' AND '$(GitVersion_ToolArgments)' != ''">
    <_BAS_CB_GitVersionAvailable>true</_BAS_CB_GitVersionAvailable>
  </PropertyGroup>

  <Target Name="BAS_CB_ConfigureGitVersion" BeforeTargets="RunGitVersion"
          Condition="'$(_BAS_CB_GitVersionAvailable)' == 'true' AND '$(BAS_CB_Use_GitVersion)' != 'false'">
    <PropertyGroup>
      <_BAS_CB_Channel>$(BAS_CB_BuildType.ToLowerInvariant())</_BAS_CB_Channel>
      <_BAS_CB_CustomGitVersionConfig Condition="'$(BAS_CB_GitVersionConfig)' != ''">$(BAS_CB_GitVersionConfig)</_BAS_CB_CustomGitVersionConfig>
      <_BAS_CB_CustomGitVersionConfig Condition="'$(_BAS_CB_CustomGitVersionConfig)' == ''">$([MSBuild]::GetPathOfFileAbove('GitVersion.yml', '$(MSBuildProjectDirectory)'))</_BAS_CB_CustomGitVersionConfig>
      <_BAS_CB_CustomGitVersionConfig Condition="'$(_BAS_CB_CustomGitVersionConfig)' == ''">$([MSBuild]::GetPathOfFileAbove('GitVersion.yaml', '$(MSBuildProjectDirectory)'))</_BAS_CB_CustomGitVersionConfig>
      <_BAS_CB_CustomGitVersionConfig Condition="'$(_BAS_CB_CustomGitVersionConfig)' == ''">$([MSBuild]::GetPathOfFileAbove('.GitVersion.yml', '$(MSBuildProjectDirectory)'))</_BAS_CB_CustomGitVersionConfig>
      <_BAS_CB_CustomGitVersionConfig Condition="'$(_BAS_CB_CustomGitVersionConfig)' == ''">$([MSBuild]::GetPathOfFileAbove('.GitVersion.yaml', '$(MSBuildProjectDirectory)'))</_BAS_CB_CustomGitVersionConfig>
      <_BAS_CB_GitVersionConfig>$(_BAS_CB_CustomGitVersionConfig)</_BAS_CB_GitVersionConfig>
      <_BAS_CB_GitVersionConfig Condition="'$(_BAS_CB_GitVersionConfig)' == ''">$(MSBuildThisFileDirectory)Basilisque.GitVersion.yml</_BAS_CB_GitVersionConfig>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_BAS_CB_Channel)', '^(alpha|ci|preview|rc|release)$'))"
           Text="BAS_CB_BuildType must be alpha, ci, preview, rc or release." />
    <Error Condition="'$(BAS_CB_NextVersion)' != '' AND !$([System.Text.RegularExpressions.Regex]::IsMatch('$(BAS_CB_NextVersion)', '^(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))"
           Text="BAS_CB_NextVersion must be a major.minor.patch version." />
    <PropertyGroup>
      <!-- GitVersion 7.0 assembles its command line during props evaluation. Add our arguments
           immediately before execution, after all project and NuGet imports have been read. -->
      <GitVersion_ToolArgments>$(GitVersion_ToolArgments) --config &quot;$(_BAS_CB_GitVersionConfig)&quot;</GitVersion_ToolArgments>
      <GitVersion_ToolArgments Condition="'$(BAS_CB_NextVersion)' != ''">$(GitVersion_ToolArgments) --override-config calculation.next-version=$(BAS_CB_NextVersion)</GitVersion_ToolArgments>
      <GitVersion_ToolArgments Condition="'$(_BAS_CB_CustomGitVersionConfig)' == '' AND '$(_BAS_CB_Channel)' == 'release'">$(GitVersion_ToolArgments) --override-config calculation.branches.main.mode=ContinuousDeployment --override-config calculation.branches.release.mode=ContinuousDeployment</GitVersion_ToolArgments>
      <!-- GitVersion sets the version properties, the .NET SDK generates the attributes and adds the SHA. -->
      <GenerateAssemblyFileVersionAttribute Condition="'$(UpdateAssemblyInfo)' == 'true'">true</GenerateAssemblyFileVersionAttribute>
      <GenerateAssemblyInformationalVersionAttribute Condition="'$(UpdateAssemblyInfo)' == 'true'">true</GenerateAssemblyInformationalVersionAttribute>
      <GenerateAssemblyVersionAttribute Condition="'$(UpdateAssemblyInfo)' == 'true'">true</GenerateAssemblyVersionAttribute>
      <UpdateAssemblyInfo>false</UpdateAssemblyInfo>
    </PropertyGroup>
    <PropertyGroup Condition="'$(_BAS_CB_CustomGitVersionConfig)' == '' AND '$(_BAS_CB_Channel)' != 'release'">
      <GitVersion_ToolArgments>$(GitVersion_ToolArgments) --override-config calculation.branches.main.label=$(_BAS_CB_Channel) --override-config calculation.branches.release.label=$(_BAS_CB_Channel)</GitVersion_ToolArgments>
      <GitVersion_ToolArgments>$(GitVersion_ToolArgments) --override-config &quot;calculation.branches.feature.label=$(_BAS_CB_Channel).feature.{BranchName}&quot;</GitVersion_ToolArgments>
      <GitVersion_ToolArgments>$(GitVersion_ToolArgments) --override-config &quot;calculation.branches.bugfix.label=$(_BAS_CB_Channel).bugfix.{BranchName}&quot;</GitVersion_ToolArgments>
      <GitVersion_ToolArgments>$(GitVersion_ToolArgments) --override-config &quot;calculation.branches.pull-request.label=$(_BAS_CB_Channel).pr{Number}&quot;</GitVersion_ToolArgments>
      <GitVersion_ToolArgments>$(GitVersion_ToolArgments) --override-config &quot;calculation.branches.unknown.label=$(_BAS_CB_Channel).branch.{BranchName}&quot;</GitVersion_ToolArgments>
    </PropertyGroup>
  </Target>

  <Target Name="BAS_CB_SetVersionProperties"
          DependsOnTargets="GetVersion"
          BeforeTargets="BeforeCompile;CoreCompile;GetAssemblyVersion;GenerateNuspec;_GetOutputItemsFromPack;EnsureWixToolsetInstalled"
          Condition="'$(_BAS_CB_GitVersionAvailable)' == 'true' AND '$(ExcludeRestorePackageImports)' != 'true'" />

  <Target Name="BAS_CB_ValidateGitVersion" AfterTargets="BAS_CB_SetVersionProperties"
          Condition="'$(_BAS_CB_Channel)' != ''">
    <PropertyGroup>
      <RepositoryType Condition="'$(RepositoryType)' == ''">git</RepositoryType>
      <_BAS_CB_ReleaseBranchLine>$([System.Text.RegularExpressions.Regex]::Replace('$(GitVersion_BranchName)', '^release/', ''))</_BAS_CB_ReleaseBranchLine>
      <_BAS_CB_IsReleaseBranch>$([System.Text.RegularExpressions.Regex]::IsMatch('$(GitVersion_BranchName)', '^release/(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)$'))</_BAS_CB_IsReleaseBranch>
    </PropertyGroup>
    <Error Condition="'$(_BAS_CB_Channel)' != 'alpha' AND '$(_BAS_CB_Channel)' != 'ci' AND '$(GitVersion_BranchName)' != 'main' AND '$(GitVersion_BranchName)' != 'master' AND '$(_BAS_CB_IsReleaseBranch)' != 'true'"
           Text="Build type '$(_BAS_CB_Channel)' is only allowed on main or release/&lt;major&gt;.&lt;minor&gt;. Current branch: $(GitVersion_BranchName)." />
    <Error Condition="'$(_BAS_CB_Channel)' == 'release' AND '$(_BAS_CB_IsReleaseBranch)' == 'true' AND '$(_BAS_CB_ReleaseBranchLine)' != '$(GitVersion_Major).$(GitVersion_Minor)'"
           Text="Version $(GitVersion_SemVer) does not belong to the $(GitVersion_BranchName) release line." />
    <Error Condition="'$(_BAS_CB_Channel)' == 'release' AND '$(GitVersion_PreReleaseLabel)' != ''"
           Text="Release build resolved to prerelease version $(GitVersion_SemVer)." />
  </Target>

  <Target Name="BAS_CB_SetAssemblyNameVersionSuffix"
          DependsOnTargets="BAS_CB_SetVersionProperties"
          BeforeTargets="PrepareForBuild;GetTargetPath;GetTargetPathWithTargetPlatformMoniker;_GetPackageFiles;PrepareForPublish"
          Condition="'$(BAS_CB_Set_AssemblyName_VersionSuffix)' == 'true' AND '$(IsCrossTargetingBuild)' != 'true'">
    <ItemGroup Condition="'$(OutputType)' != 'winmdobj'">
      <!-- The SDK captures these output items during evaluation, before versioning runs. -->
      <_BAS_CB_PreviousBuiltOutput Include="@(BuiltProjectOutputGroupKeyOutput)" Condition="'%(BuiltProjectOutputGroupKeyOutput.TargetPath)' == '$(TargetFileName)'" />
      <_BAS_CB_PreviousSymbolsOutput Include="@(DebugSymbolsProjectOutputGroupOutput)" Condition="'%(DebugSymbolsProjectOutputGroupOutput.TargetPath)' == '$(TargetName).pdb'" />
    </ItemGroup>
    <PropertyGroup>
      <AssemblyName Condition="'$(AssemblyName)' == ''">$(MSBuildProjectName)</AssemblyName>
      <_BAS_CB_AnalyzerVersion>$(PackageVersion)</_BAS_CB_AnalyzerVersion>
      <_BAS_CB_AnalyzerVersion Condition="'$(_BAS_CB_AnalyzerVersion)' == ''">$(Version)</_BAS_CB_AnalyzerVersion>
      <AssemblyName>$(AssemblyName)-$(_BAS_CB_AnalyzerVersion)</AssemblyName>
      <TargetName>$(AssemblyName)</TargetName>
      <TargetFileName>$(TargetName)$(TargetExt)</TargetFileName>
      <TargetPath>$(TargetDir)$(TargetFileName)</TargetPath>
      <TargetRefPath Condition="'$(TargetRefPath)' != ''">$([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(TargetRefPath)')), '$(TargetFileName)'))</TargetRefPath>
    </PropertyGroup>
    <ItemGroup>
      <IntermediateAssembly Remove="@(IntermediateAssembly)" />
      <IntermediateAssembly Include="$(IntermediateOutputPath)$(TargetFileName)" />
      <IntermediateRefAssembly Remove="@(IntermediateRefAssembly)" />
      <IntermediateRefAssembly Include="$(IntermediateOutputPath)refint\$(TargetFileName)" Condition="'$(ProduceReferenceAssembly)' == 'true'" />
      <_DebugSymbolsIntermediatePath Remove="@(_DebugSymbolsIntermediatePath)" />
      <_DebugSymbolsIntermediatePath Include="$(IntermediateOutputPath)$(TargetName).pdb" />
    </ItemGroup>
    <ItemGroup Condition="'$(OutputType)' != 'winmdobj'">
      <BuiltProjectOutputGroupKeyOutput Remove="@(_BAS_CB_PreviousBuiltOutput)" />
      <BuiltProjectOutputGroupKeyOutput Include="@(_BAS_CB_PreviousBuiltOutput->'$(IntermediateOutputPath)$(TargetFileName)')">
        <FinalOutputPath>$(TargetPath)</FinalOutputPath>
        <TargetPath>$(TargetFileName)</TargetPath>
      </BuiltProjectOutputGroupKeyOutput>
      <_DebugSymbolsOutputPath Remove="@(_DebugSymbolsOutputPath)" />
      <_DebugSymbolsOutputPath Include="@(_DebugSymbolsIntermediatePath->'$(OutDir)%(Filename)%(Extension)')" />
      <DebugSymbolsProjectOutputGroupOutput Remove="@(_BAS_CB_PreviousSymbolsOutput)" />
      <DebugSymbolsProjectOutputGroupOutput Include="@(_BAS_CB_PreviousSymbolsOutput->'$(IntermediateOutputPath)$(TargetName).pdb')">
        <FinalOutputPath>@(_DebugSymbolsOutputPath->'%(FullPath)')</FinalOutputPath>
        <TargetPath>$(TargetName).pdb</TargetPath>
      </DebugSymbolsProjectOutputGroupOutput>
    </ItemGroup>
  </Target>

  <Target Name="BAS_CB_LogVersionProperties" AfterTargets="BAS_CB_SetVersionProperties" Condition="'$(BAS_CB_Log_Properties)' == 'true'">
    <Message Importance="High" Text="==BAS_CB_Versions ($(MSBuildProjectName))==" />
    <Message Importance="High" Text="AssemblyVersion = $(AssemblyVersion)" />
    <Message Importance="High" Text="FileVersion = $(FileVersion)" />
    <Message Importance="High" Text="InformationalVersion = $(InformationalVersion)" />
    <Message Importance="High" Text="PackageVersion = $(PackageVersion)" />
    <Message Importance="High" Text="RepositoryType = $(RepositoryType)" />
    <Message Importance="High" Text="RepositoryBranch = $(RepositoryBranch)" />
    <Message Importance="High" Text="RepositoryCommit = $(RepositoryCommit)" />
    <Message Importance="High" Text="==BAS_CB_Versions ($(MSBuildProjectName))==" />
  </Target>
</Project>
