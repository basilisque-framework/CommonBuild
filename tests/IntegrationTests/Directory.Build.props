<Project>
  <!-- import solution level Directory.Build.props-->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))"/>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Condition="$(MSBuildProjectName.EndsWith('.TestSupport')) != true" />
  </ItemGroup>

  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('.Integration.Tests')) == true">
    <ProjectReference Include="$(MSBuildThisFileDirectory)\CommonBuild.Integration.TestSupport\CommonBuild.Integration.TestSupport.csproj" />
  </ItemGroup>
</Project>