<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
  </PropertyGroup>
  
  <ItemGroup>
    <!-- save PkgBasilisque_CommonBuild variable in assembly metadata for runtime usage -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PkgBasilisque_CommonBuild</_Parameter1>
      <_Parameter2>$(PkgBasilisque_CommonBuild)</_Parameter2>
    </AssemblyAttribute>

    <!-- save ArtifactsPath variable in assembly metadata for runtime usage -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>ArtifactsPath</_Parameter1>
      <_Parameter2>$(ArtifactsPath)</_Parameter2>
    </AssemblyAttribute>

    <!-- save Configuration variable in assembly metadata for runtime usage -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildConfiguration</_Parameter1>
      <_Parameter2>$(Configuration)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Fixtures\Consumer.Benchmarks\Consumer.Benchmarks.csproj" />
    <ProjectReference Include="..\..\Fixtures\Consumer.CodeAnalysis\Consumer.CodeAnalysis.csproj" />
    <ProjectReference Include="..\..\Fixtures\Consumer.Tests\Consumer.Tests.csproj" />
  </ItemGroup>
</Project>
